# Dockerfile for AMA Cryptography C API Build
# Provides reproducible C library builds with native PQC
#
#
# Usage:
#   docker build -t ama-cryptography-c-api:latest -f docker/Dockerfile.c-api .
#   docker run -v $(pwd)/output:/output ama-cryptography-c-api:latest
#
# The built libraries will be copied to the mounted /output directory.
#
# Base image: pinned by digest, not by tag alone. A tag is a mutable pointer,
# so a tag-only FROM makes the build unreproducible and gives an upstream
# account takeover a path straight into this image -- the same supply-chain
# reasoning behind pinning every GitHub Action to a commit SHA
# (tools/check_action_pins.py), applied to the other half of the build inputs.
# The tag is kept alongside the digest so the line stays readable; Docker
# verifies the digest and ignores the tag. ubuntu:22.04 is an LTS release
# supported to 2027-04; refreshing the digest is a deliberate edit.
#
# base-eol: 2027-04-30
# ^ read by tools/check_docker_pins.py, which fails 60 days out so the
#   base can be moved while it is still receiving fixes.

FROM ubuntu:22.04@sha256:3b06811b2afd352be909dd088a004166d665dc76d38b13eada33522a9d915c6f AS builder

# Prevent interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive

# Install build dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    ninja-build \
    git \
    pkg-config \
    libssl-dev \
    python3 \
    && rm -rf /var/lib/apt/lists/*

# Copy AMA Cryptography source
WORKDIR /ama-cryptography
COPY . .

# Build AMA Cryptography C library with native PQC
RUN mkdir -p build && cd build && \
    cmake .. \
        -DAMA_USE_NATIVE_PQC=ON \
        -DAMA_BUILD_SHARED=ON \
        -DAMA_BUILD_STATIC=ON \
        -DAMA_ENABLE_SIMD=ON \
        -DCMAKE_BUILD_TYPE=Release && \
    make -j$(nproc)

# Create output stage
FROM ubuntu:22.04@sha256:3b06811b2afd352be909dd088a004166d665dc76d38b13eada33522a9d915c6f AS output

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    libssl3 \
    && rm -rf /var/lib/apt/lists/*

# Copy AMA Cryptography libraries and headers
COPY --from=builder /ama-cryptography/build/lib* /usr/local/lib/
COPY --from=builder /ama-cryptography/include/ama_cryptography.h /usr/local/include/

# Update library cache
RUN ldconfig

# Create output directory for extraction
WORKDIR /output

# Default command: copy built artifacts to mounted volume
CMD ["sh", "-c", "mkdir -p /output/lib /output/include && \
    cp /usr/local/lib/libama_cryptography* /output/lib/ || true && \
    cp /usr/local/include/ama_cryptography.h /output/include/ && \
    echo 'AMA Cryptography C API libraries exported to /output' && \
    echo 'Contents:' && \
    ls -la /output/lib/ /output/include/"]

# Labels
LABEL org.opencontainers.image.title="AMA Cryptography C API"
LABEL org.opencontainers.image.description="Reproducible C library build with native PQC (FIPS 203/204/205)"
LABEL org.opencontainers.image.version="4.0.0"
LABEL org.opencontainers.image.vendor="Steel Security Advisors LLC"
LABEL org.opencontainers.image.licenses="Apache-2.0"
