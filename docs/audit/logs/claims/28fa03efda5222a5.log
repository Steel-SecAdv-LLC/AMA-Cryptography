    vals=[r.uniform(-1e9,1e9) for _ in range(n)] if i%4==0 else [r.choice([1e-9,1e9,0.0,3.5]) for _ in range(n)] if i%4==1 else [7.25]*n if i%4==2 else [r.choice([1.0,2.0,2.0,3.0,1e-9]) for _ in range(n)]
    for v in vals: s.update(v)
    vs=sorted(s._recent_values);m=len(vs);med=vs[m//2] if m%2 else (vs[m//2-1]+vs[m//2])/2.0
    dv=sorted(abs(v-med) for v in vs);mad=dv[m//2] if m%2 else (dv[m//2-1]+dv[m//2])/2.0
