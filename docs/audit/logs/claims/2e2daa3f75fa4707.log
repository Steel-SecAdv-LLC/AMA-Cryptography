    runs-on: ubuntu-latest
    timeout-minutes: 10
    # The release narrative has always said publication happens "under the
    # protected `release` environment", and until this block existed the
    # workflow disagreed: `publish-pypi` carried `environment: pypi` while
    # the job that actually creates the immutable release — the one holding
    # `contents: write` — was gated by nothing but its `if:`.  Referencing
    # the environment here creates it on first run WITHOUT protection
    # rules; the required-reviewer / branch-and-tag protections must be
    # configured once on the repository's Settings -> Environments page for
    # the gate to hold anything.  Until they are, this line documents the
    # intended gate rather than enforcing it, and the release runbook above
    # treats configuring it as part of the tag-time procedure.
    environment:
      name: release
      url: https://github.com/${{ github.repository }}/releases/tag/v${{ needs.preflight.outputs.version }}
