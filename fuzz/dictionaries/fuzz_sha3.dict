# SHA3 fuzzing dictionary
# Common input patterns for hash functions

# Single-byte inputs.
# NOTE: no empty-string entry — libFuzzer's ParseDictionaryFile rejects an
# empty token and discards the ENTIRE dictionary on the first malformed line,
# so one `""` silently disables every pattern below it.  The empty input is
# reachable from the empty test case without a dictionary entry.
"\x00"
"\xff"

# Block boundary sizes (SHA3-256 rate = 136 bytes)
# Triggers: exact block, one less, one more
kw_136="\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00"
kw_padding="\x06"
kw_domain_sep="\x1f"

# Keccak-specific tokens
kw_rate_256="\x01\x00\x00\x00\x00\x00\x00\x88"
